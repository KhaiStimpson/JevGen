<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>JevGen.Cli</RootNamespace>
    <!-- The assembly must not be called "jevgen": assembly names are matched case-insensitively,
         so it would collide with the JevGen library and shadow its types. The tool is still
         invoked as "jevgen" through ToolCommandName. -->
    <RollForward>LatestMajor</RollForward>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>jevgen</ToolCommandName>
    <IsPackable>true</IsPackable>
    <PackageId>JevGen.Cli</PackageId>
    <Description>Command-line tooling for JevGen: inspect generated contracts, validate them against a provider, and check an environment.</Description>

    <PublishAot>false</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../JevGen/JevGen.csproj" />
    <ProjectReference Include="../JevGen.Providers.Abstractions/JevGen.Providers.Abstractions.csproj" />
  </ItemGroup>

</Project>
